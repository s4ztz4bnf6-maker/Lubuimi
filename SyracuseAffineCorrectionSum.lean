import SyracuseAffineCore

/-!
# Syracuse affine correction sum

This module separates the exact closed form for the affine correction term
from the descent problem. It is conditional on the prescribed step equations
already used by SyracuseAffineCore; it makes no claim that arbitrary exponent
words are realizable or that every orbit descends.
-/ 

namespace SyracuseAudit

/-- Closed-form correction term generated by the recurrence
C_(k+1) = 3 C_k + 2^(A_k). -/
def affineCorrectionSum (a : Nat → Nat) : Nat → Nat
  | 0 => 0
  | k + 1 => 3 * affineCorrectionSum a k + 2 ^ prefixExponentSum a k

/-- The recursively accumulated affine right-hand side separates into
the homogeneous term 3^N*n₀ and the additive correction C_N. -/
theorem affineCompositionRhs_closed_form (a n : Nat → Nat) :
    ∀ N, affineCompositionRhs a n N =
      3 ^ N * n 0 + affineCorrectionSum a N := by
  intro N
  induction N with
  | zero =>
      simp [affineCompositionRhs, affineCorrectionSum]
  | succ k ih =>
      simp only [affineCompositionRhs, affineCorrectionSum, pow_succ]
      rw [ih]
      ring


/-- Exact descent criterion for an affine block, separated from the
Syracuse-specific powers. The hypothesis q ≤ p is essential because Nat
subtraction is truncated. -/
theorem nat_descent_iff_correction_bound
    (p q n₀ nN C : ℕ)
    (hp : 0 < p) (hqp : q ≤ p)
    (hidentity : p * nN = q * n₀ + C) :
    nN < n₀ ↔ C < (p - q) * n₀ := by
  have hmul : q * n₀ ≤ p * n₀ := Nat.mul_le_mul_right n₀ hqp
  have hsub : (p - q) * n₀ = p * n₀ - q * n₀ := by
    rw [Nat.sub_mul]
  constructor
  · intro hdesc
    have hstrict : p * nN < p * n₀ :=
      Nat.mul_lt_mul_of_pos_left hdesc hp
    rw [hidentity] at hstrict
    rw [hsub]
    omega
  · intro hbound
    have hstrict : q * n₀ + C < p * n₀ := by
      rw [hsub] at hbound
      omega
    rw [← hidentity] at hstrict
    exact (Nat.mul_lt_mul_left hp).mpr hstrict

/--
Orbit-instantiated descent criterion.  Unlike the generic arithmetic lemma
above, this connects the exact finite-prefix Syracuse step equations to the
explicit correction sum.  It is conditional on the actual step equations and
on 3^N ≤ 2^(A_N); it does not assert that such an N exists.
-/
theorem finite_prefix_descent_iff_correction_bound
    (a n : Nat → Nat)
    (hstep : ∀ k, 2 ^ a k * n (k + 1) = 3 * n k + 1)
    (N : Nat)
    (hqp : 3 ^ N ≤ 2 ^ prefixExponentSum a N) :
    n N < n 0 ↔
      affineCorrectionSum a N <
        (2 ^ prefixExponentSum a N - 3 ^ N) * n 0 := by
  have hidentity :
      2 ^ prefixExponentSum a N * n N =
        3 ^ N * n 0 + affineCorrectionSum a N := by
    rw [finite_prefix_affine_identity a n hstep N,
      affineCompositionRhs_closed_form a n N]
  exact nat_descent_iff_correction_bound
    (2 ^ prefixExponentSum a N) (3 ^ N) (n 0) (n N)
    (affineCorrectionSum a N) (by positivity) hqp hidentity


#print axioms nat_descent_iff_correction_bound

#print axioms affineCompositionRhs_closed_form

end SyracuseAudit
